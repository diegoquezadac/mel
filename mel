#!/usr/bin/env bash
# mel: record meetings (mic + system audio) and transcribe them locally.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
BIN="$ROOT/capture/.build/release/mel-capture"
PID="$ROOT/server/server.pid"
LOG="$ROOT/server/server.log"
APP="$HOME/Applications/Mel.app"
CONFIG="$ROOT/server/config.env"
IDENTITY="Mel local signing"
build_capture() { swift build -c release --package-path "$ROOT/capture"; }
# macOS ties recording permissions to the app's signature. An ad-hoc signature changes on every
# build, so the app is signed with a self-signed certificate created once in the login keychain.
ensure_identity() {
  security find-certificate -c "$IDENTITY" >/dev/null 2>&1 && return
  local tmp; tmp="$(mktemp -d)"
  openssl req -x509 -newkey rsa:2048 -nodes -days 3650 -subj "/CN=$IDENTITY" \
    -addext "keyUsage=critical,digitalSignature" -addext "extendedKeyUsage=critical,codeSigning" \
    -keyout "$tmp/key.pem" -out "$tmp/cert.pem" 2>/dev/null
  openssl pkcs12 -export -legacy -inkey "$tmp/key.pem" -in "$tmp/cert.pem" -out "$tmp/id.p12" -passout pass:mel 2>/dev/null ||
    openssl pkcs12 -export -inkey "$tmp/key.pem" -in "$tmp/cert.pem" -out "$tmp/id.p12" -passout pass:mel
  security import "$tmp/id.p12" -k "$HOME/Library/Keychains/login.keychain-db" -P mel -T /usr/bin/codesign
  rm -rf "$tmp"
  # Grants given to earlier ad-hoc builds no longer match; clear them so macOS asks again.
  for service in ScreenCapture AudioCapture Microphone; do tccutil reset "$service" local.mel >/dev/null 2>&1 || true; done
}
ICON="$ROOT/app/Icon/AppIcon.icns"
# Renders app/Icon/make-icon.swift at every size macOS asks for.
build_icon() {
  local set; set="$(mktemp -d)/AppIcon.iconset"; mkdir -p "$set"
  swift "$ROOT/app/Icon/make-icon.swift" "$set/icon_512x512@2x.png"
  for px in 16 32 128 256 512; do
    sips -z $px $px "$set/icon_512x512@2x.png" --out "$set/icon_${px}x${px}.png" >/dev/null
    [[ $px == 512 ]] || sips -z $((px * 2)) $((px * 2)) "$set/icon_512x512@2x.png" --out "$set/icon_${px}x${px}@2x.png" >/dev/null
  done
  iconutil -c icns "$set" -o "$ICON"
  rm -rf "$(dirname "$set")"
}
build_app() {
  swift build -c release --package-path "$ROOT/app"
  [[ -f "$ICON" ]] || build_icon
  rm -rf "$APP" && mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"
  cp "$ROOT/app/.build/release/mel-app" "$APP/Contents/MacOS/Mel"
  cp "$ICON" "$APP/Contents/Resources/AppIcon.icns"
  sed "s|__ROOT__|$ROOT|" "$ROOT/app/Info.plist" >"$APP/Contents/Info.plist"
  ensure_identity
  codesign --force --sign "$IDENTITY" "$APP"
}
running() { [[ -f "$PID" ]] && kill -0 "$(cat "$PID")" 2>/dev/null; }
# Languages (./mel setup) and models (the app's Settings); environment variables still work without it.
load_config() { if [[ -f "$CONFIG" ]]; then set -a; . "$CONFIG"; set +a; fi; }
start_server() {
  running && return
  load_config
  nohup uv run --quiet "$ROOT/server/app.py" >>"$LOG" 2>&1 &
  echo $! >"$PID"
}
stop_server() { running && kill "$(cat "$PID")"; rm -f "$PID"; }

cmd="${1:-help}"
shift || true
case "$cmd" in
  setup)      . "$ROOT/scripts/setup.sh"; setup ;;
  doctor)     . "$ROOT/scripts/setup.sh"; doctor ;;
  build)      build_capture && build_app ;;
  download)   load_config; exec uv run --quiet "$ROOT/server/app.py" download "$@" ;;
  app)        [[ -d "$APP" ]] || build_app; open "$APP" ;;
  server)     start_server ;;
  start)      [[ -x "$BIN" ]] || build_capture; start_server
              exec uv run --quiet "$ROOT/client/mel.py" record "$@" ;;
  transcribe) start_server; exec uv run --quiet "$ROOT/client/mel.py" transcribe "$@" ;;
  stop)       stop_server ;;
  logs)       touch "$LOG"; tail -f "$LOG" ;;
  *)          cat <<USAGE
usage: ./mel <command>

  setup                     install or update Mel, step by step
  doctor                    check that everything is in place
  app                       open the app
  start [name]              record from the terminal (Ctrl+C to stop)
        [--language xx]     force a language instead of auto-detect
        [--no-mic]          only what you hear
  transcribe <folder>       transcribe a recording again
  server | stop | logs      run, stop or follow the transcription server
  build                     rebuild the recorder and the app
  download [--speakers]     download the models (and check speaker detection)
USAGE
              exit 1 ;;
esac
